{
  "name": "ui",
  "version": "0.1.0",
  "private": true,
  "description": "Interface Vue 3 de TodoQuoi",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "vue-tsc --noEmit && eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tiptap/core": "^3.32.3",
    "@tiptap/extension-image": "^3.32.3",
    "@tiptap/extension-list": "^3.32.3",
    "@tiptap/extension-table": "^3.32.3",
    "@tiptap/pm": "^3.32.3",
    "@tiptap/starter-kit": "^3.32.3",
    "@tiptap/vue-3": "^3.32.3",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
